{
  "name": "cl.bombaspacifico",
  "author": "RaFariasS Dev",
  "description": "Bombas Pacífico: especialistas en motores eléctricos sumergibles, bombas de pozo profundo e insumos para aplicaciones hidráulicas. Ingeniería, asesoría, servicio y calidad al mejor precio del mercado.",
  "keywords": [
    "bombas de pozo profundo",
    "motores eléctricos sumergibles",
    "bombas sumergibles",
    "insumos hidráulicos",
    "aplicaciones hidráulicas",
    "asesoría técnica bombas",
    "venta de bombas Chile",
    "ingeniería hidráulica"
  ],
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0"
  },
  "eslintConfig": {
    "extends": [
      "node_modules/standard/eslintrc.json"
    ],
    "env": {
      "node": true,
      "browser": true,
      "jest": true
    }
  },
  "lint-staged": {
    "*.{css}": "stylelint",
    "*.{js,mjs,cjs,jsx}": "standard"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:js": "standard 'src/**/*.{js,mjs,cjs,jsx}'",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "daisyui": "5.7.45",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "standard": "17.1.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
